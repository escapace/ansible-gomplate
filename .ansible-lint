---

# Installed collections own their lint policy and namespace tests. Renaming their
# collection-scoped state here would change the dependency's isolation contract.
exclude_paths:
  - .ansible/collections/

skip_list:
  - command-instead-of-shell
  - experimental
  - git-latest
  - ignore-errors
  - key-order
  - name
  - no-changed-when
  - no-handler
  - package-latest
  - schema
  - yaml[indentation]
  - yaml[line-length]
  - yaml[trailing-spaces]
